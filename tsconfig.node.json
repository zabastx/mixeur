{
	"extends": "@tsconfig/node22/tsconfig.json",
	"include": [
		"vite.config.*",
		"vitest.config.*",
		"cypress.config.*",
		"nightwatch.conf.*",
		"playwright.config.*",
		"eslint.config.*",
		"plugins/*"
	],
	"compilerOptions": {
		"noEmit": true,
		"tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
		"module": "esnext",
		"moduleResolution": "bundler",
		// Vite's `configLoader: 'native'` resolves config imports through Node, which
		// does not rewrite `.js` back to `.ts` — so the config files spell out the real
		// extension and TypeScript has to allow it.
		"allowImportingTsExtensions": true,
		"types": [
			"node"
		]
	}
}