# CODING_STANDARDS.md: a commit that adds or strengthens an assertion names the
# mutation it was run against and saw fail. Only the committer knows it, so the
# check runs here rather than in review.
git rev-parse -q --verify MERGE_HEAD >/dev/null && exit 0

tests=$(sh "$(dirname "$0")/assertion-tests.sh")
[ -z "$tests" ] && exit 0

grep -qiE '^no new assertions' "$1" && exit 0

if ! grep -qiE '^mutation' "$1"; then
	echo "commit-msg: this commit adds test assertions in:" >&2
	printf '%s\n' "$tests" | sed 's/	/: /; s/^/  /' >&2
	echo "Add a line starting with 'Mutation' naming the mutation each new assertion" >&2
	echo "was run against and saw fail, or 'No new assertions' if it only moves tests." >&2
	exit 1
fi

# Each test must be named in the message, so a Mutation line covering one test
# of three fails. Whitespace is folded so a name may wrap across lines; a
# parametrised name is matched up to its first %s or $ placeholder.
message=$(grep -v '^#' "$1" | tr -s ' \t\n' ' ')
missing=$(printf '%s\n' "$tests" | while IFS='	' read -r file name; do
	stem=$(printf '%s' "$name" | sed 's/[%$].*//; s/[[:space:]]*$//')
	case "$message" in
		*"$stem"*) ;;
		*) echo "  $file: $name" ;;
	esac
done)

[ -z "$missing" ] && exit 0

echo "commit-msg: the Mutation lines do not name these tests, which gained assertions:" >&2
echo "$missing" >&2
echo "Name each test with the mutation it was run against and saw fail." >&2
exit 1
