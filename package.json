{
	"version": "0.32.2",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite",
		"preview": "vite preview",
		"build": "vite build",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write .",
		"prepare": "husky",
		"test": "vitest",
		"test:unit": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "playwright test",
		"test:e2e:all": "E2E_ALL_BROWSERS=1 playwright test",
		"test:e2e:ui": "playwright test --ui",
		"test:e2e:debug": "playwright test --debug",
		"types:generate": "bun run plugins/run-gen.ts",
		"types:check": "vue-tsc --build"
	},
	"lint-staged": {
		"src/**/*.{js,ts,vue}": [
			"eslint --fix",
			"prettier --write"
		],
		"src/**/*.css": "prettier --write",
		"*.md": "prettier --write"
	},
	"dependencies": {
		"@jaames/iro": "^5.5.2",
		"@msgpack/msgpack": "^3.1.3",
		"@tailwindcss/vite": "^4.3.3",
		"@vueuse/core": "^15.0.0",
		"pinia": "^4.1.0",
		"reka-ui": "^2.11.0",
		"tailwindcss": "^4.3.3",
		"three": "^0.186.1",
		"three-mesh-bvh": "^0.9.16",
		"three-viewport-gizmo": "^2.2.0",
		"vue": "^3.5.44"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@pinia/testing": "^2.0.2",
		"@playwright/test": "^1.64.1",
		"@testing-library/user-event": "^14.6.8",
		"@testing-library/vue": "^8.1.0",
		"@tsconfig/node22": "^22.0.6",
		"@types/gl": "^6.0.5",
		"@types/node": "^26.6.5",
		"@types/three": "^0.186.0",
		"@vitejs/plugin-vue": "^6.0.10",
		"@vitest/coverage-v8": "5.0.4",
		"@vue/test-utils": "^2.5.1",
		"@vue/tsconfig": "^0.9.1",
		"eslint": "^10.12.0",
		"eslint-config-flat-gitignore": "^2.4.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-vue": "^10.11.1",
		"gl": "^8.1.6",
		"globals": "^17.13.0",
		"happy-dom": "^21.0.1",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.0",
		"prettier": "3.9.10",
		"prettier-plugin-classnames": "^0.10.4",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"tailwind-scrollbar": "^4.0.2",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.71.2",
		"unplugin-vue-components": "^32.1.0",
		"vite": "^8.3.4",
		"vite-plugin-pwa": "^2.0.0",
		"vitest": "^5.0.4",
		"vue-eslint-parser": "^10.4.1",
		"vue-tsc": "^3.3.13"
	},
	"trustedDependencies": [
		"@tailwindcss/oxide",
		"esbuild",
		"gl",
		"vue-demi"
	]
}
